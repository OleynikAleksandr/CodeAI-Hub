{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/core", "ultracite/react"],
  "files": {
    "includes": [
      "**/*",
      "!!media/react-chat.js",
      "!!src/client/project-manager"
    ]
  },
  "linter": {
    "rules": {
      "performance": {
        // Allow barrel files in agent packages for convenient API
        "noBarrelFile": "off"
      }
    }
  }
}
