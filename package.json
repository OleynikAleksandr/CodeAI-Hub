{
  "name": "codeai-hub",
  "displayName": "CodeAI Hub",
  "description": "Unified VS Code extension for orchestrating AI providers.",
  "version": "1.2.521",
  "publisher": "CodeAIHub",
  "license": "UNLICENSED",
  "workspaces": [
    "packages/*",
    "packages/agents/shared",
    "packages/agents/description-agent"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "categories": [
    "AI",
    "Other"
  ],
  "icon": "media/icon.png",
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codeai-hub-container",
          "title": "CodeAI Hub",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "codeai-hub-container": [
        {
          "type": "webview",
          "id": "codeaiHubView",
          "name": "CodeAI Hub",
          "icon": "media/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "codeaiHub.openSettings",
        "title": "Project Manager Settings",
        "category": "CodeAI Hub",
        "icon": "$(settings-gear)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "codeaiHub.openSettings",
          "when": "view == codeaiHubView",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "check:architecture": "./scripts/check-architecture.sh",
    "check:workflow-rollback": "node ./scripts/check-workflow-rollback-architecture.mjs",
    "lint": "npx ultracite check",
    "check:knip": "knip",
    "check:dup": "npm run -s check:dup:repo && npm run -s check:dup:workspace",
    "check:dup:repo": "jscpd --threshold 3 --silent --reporters console src --ignore \"**/node_modules/**\"",
    "check:dup:workspace": "jscpd --threshold 4 --silent --reporters console src packages --ignore \"**/node_modules/**,**/dist/**,**/*.test.ts,**/*.test.tsx\"",
    "check:links": "node ./scripts/check-markdown-links.js",
    "check:security": "npm audit --omit=dev --audit-level=high",
    "check:security:all": "npm audit --audit-level=high",
    "plan:complete": "node ./scripts/plan-orchestrator/plan-cli.mjs complete",
    "plan:commit": "node ./scripts/plan-orchestrator/plan-cli.mjs commit",
    "plan:closeout": "node ./scripts/plan-orchestrator/plan-closeout.mjs",
    "plan:repair": "node ./scripts/plan-orchestrator/plan-cli.mjs repair",
    "plan:snapshot": "node ./scripts/plan-orchestrator/plan-snapshot.mjs",
    "plan:status": "node ./scripts/plan-orchestrator/plan-cli.mjs status",
    "plan:validate": "node ./scripts/plan-orchestrator/plan-cli.mjs validate",
    "typecheck:webview": "tsc -p tsconfig.webview.json --pretty false",
    "quality": "npm run check:architecture && npm run lint && npm run typecheck:webview",
    "setup:hooks": "husky",
    "build:webview": "node ./scripts/build-webview.js",
    "build:project-manager": "node ./scripts/build-project-manager.js",
    "build:core": "npm run build --workspace=@codeai-hub/core",
    "compile": "npm run build --workspace=@codeai-hub/translation && npm run build --workspace=@codeai-hub/localization && npm run build --workspace=@codeai-hub/core-supervisor && npm run build:webview && npm run typecheck:webview && tsc -p .",
    "format:fix": "npx ultracite fix",
    "fetch:models": "npx tsx scripts/fetch-available-models.ts",
    "prepare": "husky",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "keywords": [
    "AI",
    "assistant",
    "multi-agent"
  ],
  "directories": {
    "doc": "doc"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/OleynikAleksandr/CodeAI-Hub.git"
  },
  "devDependencies": {
    "@google/gemini-cli": "0.46.0",
    "@google/gemini-cli-core": "0.46.0",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.27.2",
    "jscpd": "4.0.5",
    "knip": "^6.1.0",
    "markdown-link-check": "^3.14.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "ultracite": "^7.3.2",
    "zod-to-json-schema": "^3.24.6"
  },
  "dependencies": {
    "@codeai-hub/core-supervisor": "file:packages/core-supervisor",
    "@codeai-hub/localization": "file:packages/localization",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx}": [
      "npx ultracite fix"
    ]
  },
  "optionalDependencies": {
    "@biomejs/cli-darwin-x64": "^2.4.7",
    "@biomejs/cli-linux-arm64": "^2.4.7",
    "@biomejs/cli-linux-arm64-musl": "^2.4.7",
    "@biomejs/cli-linux-x64": "^2.4.7",
    "@biomejs/cli-linux-x64-musl": "^2.4.7",
    "@biomejs/cli-win32-arm64": "^2.4.7",
    "@biomejs/cli-win32-x64": "^2.4.7"
  }
}
