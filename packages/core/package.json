{
  "name": "@codeai-hub/core",
  "version": "1.1.730",
  "description": "CodeAI Hub autonomous core orchestrator service",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "node --test dist/remote-bridge/handlers/session-request-handler.test.js"
  },
  "bin": {
    "codeai-hub-core": "dist/index.js"
  },
  "pkg": {
    "targets": [
      "node18-macos-arm64",
      "node18-macos-x64",
      "node18-win-x64",
      "node18-linux-x64"
    ],
    "outputPath": "../../doc/tmp/releases/"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@codeai-hub/claude-module": "file:../Claude_Module",
    "@codeai-hub/codex-module": "file:../Codex_Module",
    "@codeai-hub/idea-collector": "file:../agents/idea-collector",
    "@codeai-hub/initiatives": "file:../initiatives",
    "@codeai-hub/unified-session": "file:../unified-session",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "uuid": "^9.0.1",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.5.10",
    "husky": "^9.1.7",
    "lefthook": "^2.0.4",
    "lint-staged": "^16.2.7",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "ultracite": "^6.3.7"
  },
  "keywords": [
    "codeai-hub",
    "orchestrator",
    "ai-providers"
  ],
  "author": "CodeAI Hub",
  "license": "ISC"
}
