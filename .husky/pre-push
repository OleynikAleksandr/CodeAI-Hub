#!/bin/bash
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

node ./scripts/plan-orchestrator/plan-hook-pre-push.mjs

echo "🔁 Running duplication check (jscpd)..."
npm run -s check:dup || {
  echo "❌ jscpd threshold exceeded. Fix duplications or adjust the audit scope.";
  exit 1;
}

echo "🔒 Checking runtime dependency audit..."
npm run -s check:security || {
  echo "❌ Runtime dependency audit failed. Patch production dependencies.";
  exit 1;
}

echo "🔗 Checking markdown links..."
npm run -s check:links || {
  echo "❌ Markdown link check failed. Fix broken links in docs.";
  exit 1;
}

echo "✅ Pre-push checks passed"
