{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "src/extension.ts",
        "src/client/ui/src/index.tsx",
        "src/client/project-manager/index.tsx",
        "src/**/*.test.ts",
        "src/**/*.test.tsx"
      ],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/core": {
      "entry": ["src/index.ts", "src/**/*.test.ts"]
    },
    "packages/Claude_Module": {
      "entry": ["src/index.ts", "src/**/*.test.ts"]
    },
    "packages/Codex_AppServer_Module": {
      "entry": ["src/index.ts", "src/**/*.test.ts"]
    },
    "packages/Gemini_Module": {
      "entry": ["src/index.ts", "src/**/*.test.ts"]
    },
    "packages/Kimi_Module": {
      "entry": ["src/index.ts", "src/**/*.test.ts"]
    },
    "packages/localization": {
      "entry": ["src/index.ts", "src/**/*.test.ts"]
    },
    "packages/translation": {
      "entry": ["src/index.ts", "src/**/*.test.ts"]
    },
    "packages/initiatives": {
      "entry": ["src/index.ts"]
    },
    "packages/unified-session": {
      "entry": ["src/index.ts", "src/**/*.test.ts"]
    },
    "packages/core-supervisor": {
      "entry": ["src/index.ts"],
      "ignoreDependencies": ["@codeai-hub/core"]
    },
    "packages/agents/shared": {
      "entry": ["src/index.ts"]
    },
    "packages/agents/description-agent": {
      "entry": ["src/index.ts"]
    }
  },
  "ignore": [
    "packages/core/src/workflow/diagram-dsl/diagram-legacy-ownership-parser.ts",
    "packages/core/src/workflow/diagram-dsl/diagram-module-parser.ts",
    "packages/core/src/workflow/diagram-dsl/diagram-modules-parser.ts"
  ],
  "exclude": ["unlisted", "binaries", "devDependencies", "types"]
}
